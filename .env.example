# Kevin AI - Strict 4-Tier API Key Rotation Pool Configuration
# Priority 1: User custom key entered in Settings UI (stored in localStorage)
# Priority 2: Primary Environment Key
VITE_GEMINI_API_KEY=

# Priority 3: First Backup Environment Key
VITE_GEMINI_API_KEY_BACKUP=

# Priority 4: Second Backup Environment Key
VITE_GEMINI_API_KEY_BACKUP_2=